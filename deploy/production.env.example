# MẪU tệp môi trường production. Sao thành /etc/mihato/production.env trên MÁY CHỦ (chủ root, chmod 600), KHÔNG đưa vào repo.
# Mọi giá trị trống hoặc ghi "ĐỔI" phải điền trước khi chạy deploy/scripts/deploy.sh (script check-env từ chối giá trị mẫu).
# Chủ giữ khoá và lịch xoay: docs/security/secrets.md. Giá trị chỉ dùng ký tự chữ, số, + / = _ - (mật khẩu CSDL dùng hex để khỏi phải mã hoá URL).

# ── Tên miền và chứng chỉ ────────────────────────────────────────────────────────────────────────────────────
# Tên miền công khai (chưa có thì Mike cấp, docs/DECISIONS.md 07/10/2026). WEB_ORIGIN, PUBLIC_API_URL, PUBLIC_SCRIBE_WS_URL
# suy ra từ đây trong compose: https://DOMAIN, https://DOMAIN, wss://DOMAIN/scribe/ws. DNS phải trỏ về máy chủ trước khi up.
DOMAIN=
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn, sự cố cấp phát)
ACME_EMAIL=

# ── Chạy sau proxy chung (máy chủ đã có một proxy giữ cổng 80 và 443 cho nhiều ứng dụng) ───────────────────────────────
# Bỏ dấu # để web không tự giữ cổng 80/443 mà vào qua mạng Docker `edge` dưới tên mihato-web (xem deploy/compose.edge.yml).
# Proxy chung phải có một khối cho DOMAIN trỏ vào mihato-web:80. Các script triển khai tự đọc dòng này.
#MIHATO_COMPOSE_EXTRA=compose.edge.yml

# ── Ảnh (deploy.sh đặt TAG; sửa nếu registry khác) ────────────────────────────────────────────────────────────
# Mặc định là ghcr.io/mihato-tech/dieuhanh-server và dieuhanh-web (do release.yml đẩy lên khi đẩy tag v*). Chỉ đặt hai biến này khi dùng
# registry khác. KHÔNG đặt tên ảnh dựng tại máy (mihato-server): deploy.sh kéo ảnh từ registry nên sẽ báo "pull access denied".
#SERVER_IMAGE=
#WEB_IMAGE=

# ── CSDL (mật khẩu ngẫu nhiên: openssl rand -hex 24; MỖI vai trò một mật khẩu) ──────────────────────────────────
APP_DB=mihato
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_SCAN_PASSWORD=

# ── Khoá ứng dụng (≥ 32 ký tự, KHÔNG chứa "dev-" hay "change-me", MỖI khoá sinh riêng) ────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 48 (api và scribe dùng chung giá trị này)
INTERNAL_SERVICE_TOKEN=
# Khoá ES256 ký token phiên trợ lý, PKCS8 PEM một dòng, thay xuống dòng bằng \n và để trong cặp nháy ĐƠN:
#   openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt | awk 'NF {printf "%s\\n", $0}'
SCRIBE_JWT_PRIVATE_KEY=''
# false nếu chưa dùng trợ lý (khi đó không đòi khoá trên và nên để scribe không chạy)
SCRIBE_ENABLED=true

# ── Bảo mật ─────────────────────────────────────────────────────────────────────────────────────────────────
# Bắt buộc TOTP cho it_admin, office_admin, process_designer ở web (SPEC 11.2). Chỉ tắt ở staging.
ENFORCE_MFA=true
# Số lớp proxy đứng trước api để lấy IP thật (Caddy là 1). Không đổi nếu không đổi kiến trúc.
TRUST_PROXY=1
# Nguồn khác được gọi API từ trình duyệt (https, cách nhau bằng dấu phẩy). Để trống ở production.
CORS_EXTRA_ORIGINS=

# ── Nhà cung cấp (production phải là bản thật; fake chỉ cho staging kèm ALLOW_FAKE_PROVIDERS=true) ──────────────────
STT_PROVIDER=deepgram
LLM_PROVIDER=anthropic
TTS_PROVIDER=vbee
PUSH_PROVIDER=expo
ALLOW_FAKE_PROVIDERS=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
DEEPGRAM_API_KEY=
DEEPGRAM_KEYTERMS=off
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_VOICE=
# Chỉ cần khi bật "Enhanced push security" ở Expo
EXPO_ACCESS_TOKEN=
# Thư kích hoạt tài khoản: cách chính là đặt ở web quản trị (Cài đặt → Gửi thư), khoá lưu mã hoá trong CSDL theo từng tổ chức.
# Ba biến EMAIL_PROVIDER, RESEND_API_KEY, EMAIL_FROM dưới đây là DỰ PHÒNG, chỉ dùng khi tổ chức chưa đặt gì; có thể để trống.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
# Khoá mã hoá các bí mật lưu trong CSDL (khoá API thư). Để trống thì dẫn xuất từ AUTH_SECRET (đổi AUTH_SECRET sẽ làm các khoá đã lưu
# không giải được, phải nhập lại ở web quản trị). Nên đặt riêng: openssl rand -base64 48
SECRETS_ENCRYPTION_KEY=
VOICE_CONFIRM_MIN_CONFIDENCE=0.8
STT_UTTERANCE_END_MS=1300

# ── Sao lưu (deploy/scripts/backup.sh; docs/ops/backup.md) ─────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/mihato
BACKUP_KEEP_DAYS=14
# Khoá CÔNG KHAI age để mã hoá (age-keygen -> dòng "Public key"). Khoá RIÊNG cất ở kho mật khẩu của công ty, KHÔNG để trên máy chủ.
AGE_RECIPIENT=
# hoặc GPG_RECIPIENT=<email hoặc vân tay khoá công khai gpg>
# Nơi đặt bản sao KHÁC máy chủ (chờ Mike chọn, Q9). Chọn một: rclone hoặc rsync.
BACKUP_RCLONE_REMOTE=
BACKUP_RSYNC_TARGET=
# true: thiếu nơi đặt khác máy chủ thì trạng thái sao lưu là THẤT BẠI và có cảnh báo. Chỉ đặt false khi Mike chấp nhận tạm thời.
BACKUP_REQUIRE_OFFSITE=true

# ── Cảnh báo cho người trực (deploy/ops/ops-alert.mjs; người trực và kênh do Mike chỉ định, Q10) ───────────────────
ALERT_PREFIX=[MIHATO production]
# Webhook nhận JSON {"text": "..."}: Slack, Mattermost, Teams (Workflows), n8n. Hoặc Telegram bên dưới. Có thể dùng cả hai.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
