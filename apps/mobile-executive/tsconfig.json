{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@senior/*": [
        "./components/senior/*"
      ]
    }
  },
  "include": [
    "app.config.ts",
    "app",
    "src",
    "components",
    "test",
    "scripts"
  ]
}
