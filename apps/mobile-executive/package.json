{
  "name": "@mihato/mobile-executive",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go",
    "start": "expo start --go",
    "dev:client": "APP_VARIANT=dev expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "APP_VARIANT=dev expo run:ios",
    "ios:device": "APP_VARIANT=dev expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint:senior": "tsx scripts/lint-senior.ts",
    "check:duplex-swift": "bash modules/duplex-audio/check/run.sh"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "*",
    "@mihato/api-client": "workspace:*",
    "@mihato/domain": "workspace:*",
    "@mihato/i18n": "workspace:*",
    "@mihato/ui-tokens": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
