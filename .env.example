# Sao thành .env ở gốc repo. Mặc định dưới đây khớp docker-compose.yml (CSDL ở cổng 5455). CHỈ DÀNH CHO MÁY PHÁT TRIỂN.
# Máy chủ production KHÔNG dùng tệp này: dùng deploy/production.env.example (chép thành /etc/mihato/production.env, chmod 600).
# Ở NODE_ENV=production, tiến trình không đọc .env và từ chối khởi động nếu cấu hình sai (docs/ops/runbook.md): phần "Production"
# ở cuối tệp này liệt kê các luật.
NODE_ENV=development

DATABASE_URL=postgres://app_user:app_user_dev@127.0.0.1:5455/mihato_dev
DATABASE_URL_OWNER=postgres://app_owner:app_owner_dev@127.0.0.1:5455/mihato_dev
DATABASE_URL_SCAN=postgres://app_scan:app_scan_dev@127.0.0.1:5455/mihato_dev
TEST_DATABASE_URL=postgres://app_user:app_user_dev@127.0.0.1:5455/mihato_test
TEST_DATABASE_URL_OWNER=postgres://app_owner:app_owner_dev@127.0.0.1:5455/mihato_test
TEST_DATABASE_URL_SCAN=postgres://app_scan:app_scan_dev@127.0.0.1:5455/mihato_test

API_PORT=3100
SCRIBE_PORT=3200
WEB_ORIGIN=http://localhost:5273
# Nguồn khác được gọi API từ trình duyệt, cách nhau bằng dấu phẩy. Mặc định ở phát triển là bản web của app (Expo web, cổng 8081).
# CORS_EXTRA_ORIGINS=http://localhost:8081
PUBLIC_API_URL=http://localhost:3100
PUBLIC_SCRIBE_WS_URL=ws://localhost:3200/scribe/ws
# Thử app trên điện thoại thật hoặc máy ảo: đổi hai địa chỉ trên sang địa chỉ máy tính trong mạng nội bộ (Android Studio: 10.0.2.2),
# ví dụ PUBLIC_API_URL=http://192.168.1.4:3100 và PUBLIC_SCRIBE_WS_URL=ws://192.168.1.4:3200/scribe/ws,
# rồi chạy lại api, scribe và `pnpm db:seed -- --links` (đường dẫn kích hoạt mang địa chỉ API lúc tạo).
API_INTERNAL_URL=http://127.0.0.1:3100
# Giá trị dev dưới đây bị TỪ CHỐI ở production (cố ý): chỉ dùng trên máy phát triển.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

# Nhà cung cấp: fake (mặc định, không tốn tiền) hoặc thật. CI luôn dùng fake (SPEC 13.1).
STT_PROVIDER=fake        # fake | deepgram  (vbee chưa cài: đặt vào thì scribe báo lỗi lúc khởi động)
LLM_PROVIDER=fake        # fake | anthropic
TTS_PROVIDER=fake        # fake | vbee
PUSH_PROVIDER=fake       # fake | expo

LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Gửi tên người, đơn vị, tên quy trình làm `keyterm` cho Deepgram. MẶC ĐỊNH TẮT: đo thật ngày 04/10/2026, từ 3 từ khoá trở lên
# thì Deepgram tiếng Việt trả rỗng mọi câu (trợ lý luôn báo "nghe chưa rõ"). Chỉ bật (on) khi đã đo lại và thấy có lợi.
DEEPGRAM_KEYTERMS=off
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_VOICE=
EXPO_ACCESS_TOKEN=
# Thư kích hoạt tài khoản: cách chính là đặt ở web quản trị (Cài đặt → Gửi thư); khoá lưu mã hoá trong CSDL theo từng tổ chức.
# Ba biến dưới đây chỉ là DỰ PHÒNG khi tổ chức chưa đặt gì (bỏ trống thì thư chỉ ghi nhận, không ra ngoài ở phát triển).
EMAIL_PROVIDER=fake      # fake | resend
RESEND_API_KEY=
EMAIL_FROM=
# Khoá mã hoá bí mật trong CSDL; trống thì dẫn xuất từ AUTH_SECRET.
SECRETS_ENCRYPTION_KEY=

VOICE_CONFIRM_MIN_CONFIDENCE=0.8

# Chỉ dùng với STT giả: mỗi lần bấm micro "nghe" câu kế tiếp trong danh sách, hết thì quay vòng.
FAKE_STT_SCRIPT=
# Chỉ dùng với STT giả: tự chốt lượt nói sau từng này khối âm thanh (mỗi khối 60 ms từ app), như Deepgram báo người nói đã ngừng.
# Có số này thì chế độ trò chuyện của app chạy trọn vòng (nói, ngừng, trợ lý trả lời, nghe tiếp) mà không cần Deepgram. Ví dụ 25 (1,5 giây).
FAKE_STT_AUTO_END_CHUNKS=
STT_UTTERANCE_END_MS=1300

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# Production (chỉ để đối chiếu; đặt trong /etc/mihato/production.env, không đặt ở đây)
# ═════════════════════════════════════════════════════════════════════════════════════════════════
# Ở NODE_ENV=production tiến trình báo lỗi rõ và không khởi động nếu:
#   - WEB_ORIGIN hoặc PUBLIC_API_URL không phải https://; PUBLIC_SCRIBE_WS_URL thiếu hoặc không phải wss://; trỏ về localhost
#   - AUTH_SECRET hoặc INTERNAL_SERVICE_TOKEN ngắn hơn 32 ký tự, chứa "dev-" hoặc "change-me", hoặc trùng nhau
#     (sinh: openssl rand -base64 48)
#   - DATABASE_URL* còn mật khẩu mặc định đuôi _dev, hoặc tên CSDL có đuôi _dev hoặc _test
#   - FILE_STORAGE_DIR thiếu, không tuyệt đối, hoặc không ghi được (phải là volume dùng chung của api và worker, có sao lưu)
#   - SCRIBE_JWT_PRIVATE_KEY thiếu khi Scribe bật (SCRIBE_ENABLED, mặc định true), hoặc không phải khoá ES256 PKCS8:
#       openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt   (nhiều dòng thì thay xuống dòng bằng \n)
#   - STT_PROVIDER, LLM_PROVIDER, TTS_PROVIDER hoặc PUSH_PROVIDER là fake (kể cả để trống) mà không có ALLOW_FAKE_PROVIDERS=true
#     (cờ này chỉ cho staging); chọn thật mà thiếu khoá API tương ứng
# Biến chỉ có ý nghĩa ở production:
# FILE_STORAGE_DIR=/data/files
# AUTH_SECRET=
# SCRIBE_JWT_PRIVATE_KEY=
# SCRIBE_ENABLED=true
# ALLOW_FAKE_PROVIDERS=false
# ENFORCE_MFA=true
# TRUST_PROXY=1
# Kiểm cấu hình trước khi triển khai (không in giá trị): pnpm env:check, hoặc deploy/scripts/check-env.sh <tag>
